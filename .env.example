# Postgres connection string. Local dev: a local Postgres or `railway run`.
# On Railway this is set to a reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:pass@localhost:5432/tuhaf?schema=public"
# iron-session cookie secret — min 32 chars. Generate: openssl rand -hex 32
SESSION_SECRET="change-me-min-32-characters-long-please"
# Resend API key (magic-link email). Empty in dev → links print to server console.
RESEND_API_KEY=""
# Must use a Resend-verified domain in production. onboarding@resend.dev only
# delivers to the Resend account owner (test mode).
EMAIL_FROM="Tuhaf Club <onboarding@resend.dev>"
# Public origin used to build magic-link URLs. In prod = the deployed domain.
APP_URL="http://localhost:3000"
