// Tuhaf Club — data model.
// SQLite for local/synthetic-data dev; kept Postgres-portable:
// app-generated cuid IDs, no SQLite-only features, ISO/DateTime timestamps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A reader. Auth is a simple allowlist: known email -> session.
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  avatarSeed  String
  image       String? // uploaded photo as a data URL (base64), or null -> generated avatar
  bio         String?
  age         Int?
  gender      String? // 'kadin' | 'erkek' | 'diger' | 'belirtmek-istemiyorum'
  location    String?
  interests   String   @default("[]") // JSON array of category keys
  onboarded   Boolean  @default(false)
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())

  highlights    Highlight[]
  following     Follow[]            @relation("follower")
  followers     Follow[]            @relation("followee")
  notifications Notification[]      @relation("recipient")
  actedOn       Notification[]      @relation("actor")
  reactions     HighlightReaction[]
  notes         Note[]
}

/// A Club member / author who publishes one page per day.
model Publisher {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  title       String // e.g. "Nörobilim", "Gastronomi"
  category    String
  bio         String
  avatarSeed  String
  image       String? // /club/<slug>.jpg if present in /public, else null -> generated avatar
  accentColor String  @default("#D9291C")

  articles Article[]
}

/// A brand sponsoring a category rail (logo embedded in the rail title).
model Sponsor {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  logoText String // wordmark rendered in brand style
  category String

  articles Article[]
}

model Article {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  subject       String // dek / standfirst
  category      String
  pullQuote     String
  readMinutes   Int      @default(4)
  listenSeconds Int      @default(240)
  audioUrl      String?
  posterTheme   String   @default("crimson") // poster color key
  status        String   @default("published") // 'draft' | 'published'
  isLive        Boolean  @default(false) // "Şimdi Yayında" billboard pick
  publishedAt   DateTime
  createdAt     DateTime @default(now())

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id])
  sponsorId   String?
  sponsor     Sponsor?  @relation(fields: [sponsorId], references: [id])

  blocks     ArticleBlock[]
  highlights Highlight[]
  notes      Note[]

  @@index([publishedAt])
  @@index([publisherId, publishedAt])
  @@index([category])
}

/// One ordered block of canonical (NFC-normalized) text.
/// The stored `text` is THE coordinate system for highlight offsets.
model ArticleBlock {
  id    String @id @default(cuid())
  index Int
  type  String @default("paragraph") // 'paragraph' | 'heading' | 'blockquote'
  text  String

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  highlights Highlight[]
  notes      Note[]

  @@unique([articleId, index])
  @@index([articleId])
}

/// A reader's underline, scoped to a single block.
/// Offsets are UTF-16 code units into the block's canonical text, word-snapped.
model Highlight {
  id          String   @id @default(cuid())
  startOffset Int
  endOffset   Int // exclusive
  text        String // denormalized slice (quote cards / drift check)
  createdAt   DateTime @default(now())

  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  blockId   String
  block     ArticleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  articleId String
  article   Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)

  reactions HighlightReaction[]

  @@unique([userId, blockId, startOffset, endOffset])
  @@index([blockId])
  @@index([articleId])
  @@index([userId])
  @@index([articleId, userId])
}

/// Directed social graph edge.
model Follow {
  followerId String
  follower   User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User   @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
}

/// "Abone Ol" newsletter signup.
model EmailSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("confirmed") // 'pending' | 'confirmed' | 'unsubscribed'
  createdAt DateTime @default(now())
}

/// Backs the notification bell.
model Notification {
  id          String   @id @default(cuid())
  type        String // 'overlap' | 'follow' | 'new_article' | 'reaction' | 'note' | 'reply'
  body        String
  link        String? // optional deep link target
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?    @relation("actor", fields: [actorUserId], references: [id])
  articleId   String?

  @@index([userId, read])
}

/// A lightweight "ben de" reaction on another reader's underline.
model HighlightReaction {
  id        String   @id @default(cuid())
  type      String   @default("love")
  createdAt DateTime @default(now())

  highlightId String
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([highlightId, userId])
  @@index([highlightId])
  @@index([userId])
}

/// A note anchored to a span of text (block + offsets). A top-level note starts
/// a discussion on a sentence; a reply (parentId set) inherits the parent span.
model Note {
  id          String   @id @default(cuid())
  body        String
  startOffset Int
  endOffset   Int
  text        String // denormalized span slice
  createdAt   DateTime @default(now())

  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  blockId   String
  block     ArticleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  articleId String
  article   Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Note?   @relation("NoteReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Note[]  @relation("NoteReplies")

  @@index([articleId])
  @@index([blockId, startOffset, endOffset])
  @@index([userId])
  @@index([parentId])
}

/// Editorial category, managed from the admin dashboard. Articles still store
/// `category` as a denormalized string; this table drives the picker + ordering.
model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  accent    String   @default("#D9291C")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// Lightweight analytics event (open / listen / click). articleId & userId are
/// stored as plain columns (no FK) so events survive content/user churn.
model Event {
  id        String   @id @default(cuid())
  type      String // 'open' | 'listen' | 'click'
  articleId String?
  userId    String?
  label     String? // e.g. click target ('card', 'oku', 'dinle', 'share')
  createdAt DateTime @default(now())

  @@index([type])
  @@index([articleId])
  @@index([createdAt])
}
